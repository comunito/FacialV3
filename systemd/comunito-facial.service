[Unit]
Description=Comunito autonomous facial access portal
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=USER_PLACEHOLDER
WorkingDirectory=/home/USER_PLACEHOLDER/comunito_facial
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/USER_PLACEHOLDER/comunito_facial/comunito-venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
